# ============================================================
# SeuDinheiro — Variáveis de Ambiente
# Copie este arquivo para backend/.env e preencha os valores.
# ============================================================

# PostgreSQL
POSTGRES_DB=seudinheiro
POSTGRES_USER=seudinheiro
POSTGRES_PASSWORD=seudinheiro_dev

# Backend
DATABASE_URL=postgresql://seudinheiro:seudinheiro_dev@localhost:5432/seudinheiro
REDIS_URL=redis://localhost:6379
JWT_SECRET=mude-este-segredo-em-producao
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
PORT=3000
CORS_ORIGIN=http://localhost:5173
NODE_ENV=development

# Frontend
VITE_API_URL=http://localhost:3000/api
